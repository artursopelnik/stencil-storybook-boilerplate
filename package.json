{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^25.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@eslint/json": "^1.2.0",
    "archiver": "^8.0.0",
    "eslint": "^9",
    "globals": "^17.6.0",
    "lerna": "^9.0.7",
    "npm-check-updates": "^22.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2"
  },
  "scripts": {
    "build": "npm run build:tokens && npx lerna run build",
    "build:tokens": "npx lerna run build --scope='@stencil-storybook-boilerplate/design-tokens'",
    "package": "npm run package:build && npm run package:zip",
    "package:build": "npm run build:tokens && npx lerna run build --scope='@stencil-storybook-boilerplate/core'",
    "package:zip": "node scripts/create-zip.mjs",
    "package:upload": "node scripts/upload-confluence.mjs",
    "update": "npx npm-check-updates -u",
    "format": "npx prettier . --write",
    "lint": "npx eslint .  --fix"
  }
}
