{
  "name": "@stencil-storybook-boilerplate/storybook",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook.run": "storybook dev -p 6006",
    "storybook": "concurrently \"(cd ../core/ && npm start)\" \"npm run storybook.run\"",
    "build-storybook": "storybook build",
    "build-storybook-ci": "BASE_PATH=/stencil-storybook-boilerplate/ storybook build",
    "preview-storybook": "npx http-server storybook-static",
    "update": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@stencil-storybook-boilerplate/core": "*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-links": "^10.5.4",
    "@storybook/addon-themes": "^10.5.4",
    "@storybook/web-components-vite": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint-plugin-storybook": "10.5.4",
    "http-server": "^14.1.1",
    "storybook": "^10.5.4",
    "vite": "^8.1.5",
    "vite-plugin-live-reload": "^3.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
