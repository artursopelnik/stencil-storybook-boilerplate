# Konfiguration für `npm run package:upload` (Confluence On Prem / Data Center)
# Kopie als .env anlegen – .env ist git-ignoriert und darf keine Secrets ins Repo bringen.
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_PAGE_ID=123456
# Empfohlen: Personal Access Token (Confluence ≥ 7.9, unter Profil → Einstellungen → Persönliche Zugriffstoken)
CONFLUENCE_PAT=
# Alternative: Basic Auth
#CONFLUENCE_USER=
#CONFLUENCE_PASSWORD=
